#!/usr/bin/env bash
# dotf — Dotfiles CLI shim
# 零逻辑：分发到 python3 -m dotf_cli。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "[dotf] env: 未找到 python3，请先安装 Python 3" >&2
  exit 2
fi

export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m dotf_cli "$@"
