{
  "mcp": {
    "servers": {
      "web-search-prime": {
        "type": "http",
        "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
        "headers": {
          "Authorization": "Bearer ${ZHIPU_API_KEY}"
        }
      },
      "web-reader": {
        "type": "http",
        "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
        "headers": {
          "Authorization": "Bearer ${ZHIPU_API_KEY}"
        }
      },
      "zread": {
        "type": "http",
        "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
        "headers": {
          "Authorization": "Bearer ${ZHIPU_API_KEY}"
        }
      },
      "zai-vision": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@z_ai/mcp-server@0.1.5"
        ],
        "env": {
          "Z_AI_API_KEY": "${ZHIPU_API_KEY}",
          "Z_AI_MODE": "ZHIPU"
        }
      },
      "playwright": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@0.0.80",
          "--browser",
          "chromium",
          "--headless",
          "--user-data-dir",
          "/tmp/agent-env/browser/profile",
          "--output-dir",
          "/tmp/agent-env/browser/artifacts"
        ]
      }
    }
  }
}
