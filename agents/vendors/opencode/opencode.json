{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "prompt": "请使用中文进行思考和回答。"
    },
    "plan": {
      "prompt": "请使用中文进行思考和回答。"
    }
  },
  "provider": {},
  "mcp": {
    "web-search-prime": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless",
        "--user-data-dir",
        "/tmp/agent-env/browser/profile",
        "--output-dir",
        "/tmp/agent-env/browser/artifacts"
      ]
    },
    "zai-vision": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server@latest"
      ],
      "environment": {
        "Z_AI_API_KEY": "{env:ZHIPU_API_KEY}",
        "Z_AI_MODE": "ZHIPU"
      }
    }
  }
}
