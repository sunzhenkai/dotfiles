+)
+MIRROR_VERSION = 1
+SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
+
+GO_FUNC = re.compile(r"^func\s+(?:\([^)]+\)\s+)?(\w+)\s*\(", re.M)
+GO_TYPE = re.compile(r"^type\s+(\w+)\s+", re.M)
+GO_VAR = re.compile(r"^(?:var|const)\s+(\w+)\b", re.M)
+JS_FN = re.compile(
+    r"^(?:export\s+)?(?:async\s+)?function\s+(\w+)\s*\(", re.M
