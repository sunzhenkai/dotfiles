+JS_CONST = re.compile(
+    r"^(?:export\s+)?(?:const|let|var)\s+(\w+)\s*=", re.M
+)
+RUST_FN = re.compile(r"^(?:pub(?:\([^)]+\))?\s+)?(?:async\s+)?fn\s+(\w+)\s*[<(]", re.M)
+RUST_TYPE = re.compile(
+    r"^(?:pub(?:\([^)]+\))?\s+)?(?:struct|enum|type|trait)\s+(\w+)\b", re.M
