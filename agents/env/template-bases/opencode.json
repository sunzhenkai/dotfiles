{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "prompt": "请使用中文进行思考和回答。"
    },
    "plan": {
      "prompt": "请使用中文进行思考和回答。"
    }
  },
  "provider": {
    "minimax": {
      "npm": "@ai-sdk/openai",
      "name": "MiniMax",
      "env": [
        "MINIMAX_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.minimaxi.com/v1",
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax-M3"
        },
        "MiniMax-M2.7": {
          "name": "MiniMax-M2.7"
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7 Highspeed"
        },
        "MiniMax-M2.5": {
          "name": "MiniMax-M2.5"
        },
        "MiniMax-M2.5-highspeed": {
          "name": "MiniMax-M2.5 Highspeed"
        }
      }
    },
    "nativex": {
      "npm": "@ai-sdk/openai",
      "name": "NativeX",
      "env": [
        "NATIVEX_API_KEY"
      ],
      "options": {
        "baseURL": "https://ailink.nativex.com/v1",
        "apiKey": "{env:NATIVEX_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731"
        },
        "deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813"
        }
      }
    },
    "company": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Company",
      "env": [
        "COMPANY_API_KEY"
      ],
      "options": {
        "baseURL": "{env:COMPANY_BASE_URL}",
        "apiKey": "{env:COMPANY_API_KEY}"
      },
      "models": {
        "vanchin/deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813"
        }
      }
    },
    "kimi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi",
      "env": [
        "KIMI_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.kimi.com/coding/v1",
        "apiKey": "{env:KIMI_API_KEY}"
      },
      "models": {
        "kimi-for-coding": {
          "name": "Kimi For Coding"
        },
        "kimi-for-coding-highspeed": {
          "name": "Kimi For Coding Highspeed"
        },
        "k3-256k": {
          "name": "K3 256K"
        },
        "k3": {
          "name": "K3"
        }
      }
    },
    "zhipu": {
      "npm": "@ai-sdk/openai",
      "name": "Zhipu Coding Plan",
      "env": [
        "ZHIPU_API_KEY"
      ],
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/v1",
        "apiKey": "{env:ZHIPU_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3"
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash"
        },
        "glm-5-turbo": {
          "name": "GLM-5 Turbo"
        }
      }
    },
    "scnet": {
      "npm": "@ai-sdk/openai",
      "name": "SCNet",
      "env": [
        "SCNET_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.scnet.cn/api/llm/v1",
        "apiKey": "{env:SCNET_API_KEY}"
      },
      "models": {
        "DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731"
        },
        "DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro 0813"
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3"
        },
        "GLM-5.3": {
          "name": "GLM-5.3"
        },
        "Kimi-K2.7-Code": {
          "name": "Kimi K2.7 Code"
        }
      }
    }
  },
  "model": "minimax/MiniMax-M3"
}
